# Fails if memory keeps growing under everyday work. It takes minutes, so it
# only runs when asked for. Optimised builds are where a space leak shows, so
# this also runs as the cabal test-suite.
haskell_test(
    name = "soak_test",
    size = "enormous",
    srcs = ["soak.hs"],
    ghcopts = [
        "-threaded",
        "-rtsopts",
        "-with-rtsopts=-T",
    ],
    tags = [
        "haskell",
        "manual",
        "no-cross",
    ],
    deps = [
        "//hs-toxcore:tox-application",
        "//hs-toxcore:tox-core",
        "//hs-toxcore:tox-crypto",
        "//hs-toxcore:tox-dht",
        "//hs-toxcore:tox-network",
        "//third_party/haskell:base",
        "//third_party/haskell:binary",
        "//third_party/haskell:bytestring",
        "//third_party/haskell:containers",
        "//third_party/haskell:network",
        "//third_party/haskell:text",
    ],
)

