[sh_test(
    name = "c_interop_%s_test" % mode.replace("-", "_"),
    size = "large" if mode in ["file-tcp", "restart", "group3", "group3-c", "group-restart", "group-reload", "public-group-tcp", "hs-public-group-tcp"] else "medium",
    srcs = ["c-interop-test.sh"],
    args = [
        "$(location :tox-c-peer)",
        "$(location :tox-dht-node)",
        mode,
    ],
    data = [
        ":tox-c-peer",
        ":tox-dht-node",
    ],
    # Each in its own network, or a node one test restarts can get a port
    # another test's peers still send to.
    tags = [
        "block-network",
        "haskell",
        "no-cross",
        "no-windows",
    ],
) for mode in [
    "direct",
    "custom",
    "hs-request",
    "c-request",
    "tcp",
    "hs-relay",
    "restart",
    "file",
    "file-tcp",
    "ipv6",
    "conference",
    "conference3",
    "c-conference",
    "c-av-conference",
    "conference-reload",
    "group",
    "hs-group",
    "group3",
    "group3-c",
    "public-group",
    "hs-public-group",
    "group-restart",
    "group-reload",
    "group-leave",
    "group-leave-tcp",
    "group-topic",
    "group-private",
    "hs-group-topic",
    "group-tcp",
    "hs-group-tcp",
    "public-group-tcp",
    "hs-public-group-tcp",
    "group-mod",
    "hs-group-mod",
]]

