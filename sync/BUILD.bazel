load("@rules_haskell//haskell:defs.bzl", "haskell_library", "haskell_test")

# Cabal builds get SHA-256 from cryptohash-sha256, Bazel from cryptohash
# (same Crypto.Hash.SHA256 module).
haskell_library(
    name = "toxcore-sync",
    srcs = glob(["src/**/*.hs"]),
    src_strip_prefix = "src",
    tags = [
        "haskell",
        "no-cross",
    ],
    visibility = ["//visibility:public"],
    deps = [
        "//third_party/haskell:base",
        "//third_party/haskell:base16-bytestring",
        "//third_party/haskell:bytestring",
        "//third_party/haskell:containers",
        "//third_party/haskell:cryptohash",
        "//third_party/haskell:text",
    ],
)

haskell_test(
    name = "testsuite",
    size = "small",
    srcs = glob(["test/**/*.hs"]),
    data = glob(["test/conformance/*.json"]),
    main_file = "test/testsuite.hs",
    src_strip_prefix = "test",
    tags = ["haskell"],
    deps = [
        ":toxcore-sync",
        "//third_party/haskell:aeson",
        "//third_party/haskell:base",
        "//third_party/haskell:base16-bytestring",
        "//third_party/haskell:bytestring",
        "//third_party/haskell:containers",
        "//third_party/haskell:directory",
        "//third_party/haskell:hspec",
        "//third_party/haskell:scientific",
        "//third_party/haskell:text",
        "//third_party/haskell:vector",
    ],
)
